<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.finite.DisplayUnit">
    <value nick="seconds" value="0"/>
    <value nick="minutes" value="1"/>
    <value nick="hours" value="2"/>
    <value nick="days" value="3"/>
    <value nick="weeks" value="4"/>
    <value nick="percent" value="5"/>
  </enum>

  <enum id="org.gnome.shell.extensions.finite.PanelPosition">
    <value nick="left" value="0"/>
    <value nick="center" value="1"/>
    <value nick="right" value="2"/>
  </enum>

  <schema id="org.gnome.shell.extensions.finite" path="/org/gnome/shell/extensions/finite/">
    <key name="birth-date" type="s">
      <default>""</default>
      <summary>Birth date (YYYY-MM-DD)</summary>
      <description>Local calendar birth date in ISO YYYY-MM-DD format.</description>
    </key>
    <key name="life-expectancy-years" type="i">
      <range min="1" max="150"/>
      <default>80</default>
      <summary>Expected lifespan in years</summary>
      <description>Target life expectancy in years (1 to 150).</description>
    </key>
    <key name="display-unit" type="s">
      <choices>
        <choice value="seconds"/>
        <choice value="minutes"/>
        <choice value="hours"/>
        <choice value="days"/>
        <choice value="weeks"/>
        <choice value="percent"/>
      </choices>
      <default>"weeks"</default>
      <summary>Top bar display unit</summary>
      <description>Unit shown as a plain number on the GNOME top bar.</description>
    </key>
    <key name="panel-position" type="s">
      <choices>
        <choice value="left"/>
        <choice value="center"/>
        <choice value="right"/>
      </choices>
      <default>"center"</default>
      <summary>Top bar panel box</summary>
      <description>Panel box where the counter appears (left, center, right).</description>
    </key>
    <key name="panel-index" type="i">
      <range min="0" max="20"/>
      <default>1</default>
      <summary>Panel box position index</summary>
      <description>Insertion index inside the selected GNOME top bar box.</description>
    </key>
    <key name="reminder-text" type="s">
      <default>"Hôm nay là một phần không quay lại."</default>
      <summary>Popover reminder quote</summary>
      <description>Short plain-text reminder shown inside the life-grid popover.</description>
    </key>
  </schema>
</schemalist>
